<?xml version="1.0" encoding="utf-8"?>
<!-- The card log as plain text, in the style of the QR dialogs: a centered card over the dimmed settings -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:paddingTop="27dp"
    android:paddingBottom="27dp">

    <LinearLayout
        android:layout_width="820dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/qr_dialog_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="18dp"
        android:paddingEnd="28dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_act_status" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/focused_log_title"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/focused_log_newest"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <!-- wrap_content with weight: as tall as the text, shrunk to what's left when it doesn't fit -->
        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/focused_log_panel"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:padding="12dp">

            <TextView
                android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.1"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp" />
        </ScrollView>

        <Button
            android:id="@+id/log_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/qr_dialog_button"
            android:minWidth="140dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/close"
            android:textAllCaps="false"
            android:textColor="@color/qr_dialog_button_text"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
